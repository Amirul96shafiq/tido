APP_NAME=tido
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tido.local
# LAN-only (same Wi-Fi). Not a public website. PHP still listens on :2000; map :80 → :2000 with:
#   netsh interface portproxy add v4tov4 listenport=80 listenaddress=0.0.0.0 connectport=2000 connectaddress=127.0.0.1
# PC hosts (Administrator): 127.0.0.1 tido.local
# Phone: map tido.local → this PC's LAN IPv4, or open http://<PC-LAN-IP>/admin
# Firewall (optional): inbound TCP 80, 5173, and 8081 (Reverb) from the LAN subnet only.
# Restart npm run dev:full / dev:all after changing.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_BUSY_TIMEOUT=5000
# DB_JOURNAL_MODE=wal

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Laravel Reverb — Expenses table live sync. Port 8081; Evolution uses 8080.
# See docs/realtime-broadcasting.md
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tido
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SERVER_PORT=8081
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Disposable sandbox for backup/wipe browser tests (port 2001). See docs/sandbox-testing.md.
# Do not set these on the live-like local instance.
# APP_STORAGE_PATH=storage/sandbox
# FILESYSTEM_PUBLIC_URL=/sandbox-storage

# Restore ZIP limits (BackupService inspects the central directory before any writes).
# Compressed guest upload size; uncompressed/entry/ratio/duration limits apply to every restore.
# BACKUP_RESTORE_MAX_UPLOAD_KILOBYTES=51200
# BACKUP_RESTORE_MAX_ENTRIES=5000
# BACKUP_RESTORE_MAX_UNCOMPRESSED_BYTES=209715200
# BACKUP_RESTORE_MAX_ENTRY_BYTES=52428800
# BACKUP_RESTORE_MAX_COMPRESSION_RATIO=100
# BACKUP_RESTORE_MAX_DURATION_SECONDS=60

# Required for encrypted backups. 32+ characters. Backups fail closed when unset.
# BACKUP_ARCHIVE_PASSWORD=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Auth link lifetime in seconds (email-change + password-reset: signed URL, token TTL, mail copy).
# Defaults: 30 outside production, 259200 (3 days) when APP_ENV=production.
# AUTH_VERIFICATION_EXPIRE=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Ollama (receipt vision OCR) — native host install, no Docker
# See docs/ollama-setup.md
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# Historical exchange rates for foreign-currency receipts (CurrencyAPI)
# The key is required only when a receipt is detected as non-MYR.
CURRENCY_API_PROVIDER=currencyapi
CURRENCY_API_BASE_URL=https://api.currencyapi.com
CURRENCY_API_KEY=
CURRENCY_API_TIMEOUT=10
CURRENCY_API_CONNECT_TIMEOUT=3
# Optional trusted CA bundle path for PHP cURL on Windows hosts without a configured certificate store.
CURRENCY_API_CAINFO=
CURRENCY_API_CACHE_TTL=86400

# WhatsApp PDF receipt parsing (Poppler: pdfinfo + pdftocairo + pdftotext)
PDF_MAX_BYTES=10485760
PDF_MAX_PAGES=4
PDF_INSPECTION_TIMEOUT=15
PDF_RENDER_TIMEOUT=60
PDF_TEXT_TIMEOUT=15
PDF_RENDER_DPI=144

# Use absolute executable paths on Windows when the queue worker does not inherit the shell PATH.
# The renderer falls back to pdftoppm when pdftocairo is unavailable.
PDFINFO_BINARY=pdfinfo
PDFTOCAIRO_BINARY=pdftocairo
PDFTOPPM_BINARY=pdftoppm
PDFTOTEXT_BINARY=pdftotext

# Evolution API (WhatsApp) — host process via `npm run evolution`
# See docs/evolution-local-windows.md
EVOLUTION_API_URL=http://127.0.0.1:8080
# Generate a distinct random value of at least 32 characters for each secret.
# Must match Evolution AUTHENTICATION_API_KEY exactly; used only for outbound Evolution API calls.
EVOLUTION_API_KEY=
# Used only in the Authorization header on Evolution -> tido webhook callbacks; must differ from EVOLUTION_API_KEY.
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_INSTANCE_NAME=tido
# Exact source IPs allowed to POST /api/webhooks/whatsapp (comma-separated). Empty = reject all.
# Default loopback for Evolution on the same host. Behind a reverse proxy, list Evolution's true source IP.
EVOLUTION_WEBHOOK_ALLOWED_IPS=127.0.0.1,::1
# EVOLUTION_WEBHOOK_MAX_BODY_BYTES=262144
# EVOLUTION_WEBHOOK_MAX_TEXT_CHARS=8192
# EVOLUTION_WEBHOOK_MESSAGE_ID_MAX=128
# EVOLUTION_WEBHOOK_PER_IP_ATTEMPTS_PER_MINUTE=60
# EVOLUTION_WEBHOOK_GLOBAL_ATTEMPTS_PER_MINUTE=60
# EVOLUTION_WEBHOOK_PER_SENDER_ATTEMPTS_PER_MINUTE=20
# EVOLUTION_WEBHOOK_IDEMPOTENCY_TTL_SECONDS=604800
# Optional one-time import for seed only (Profile + Family Members are the runtime source of truth)
# PERSONAL_WHATSAPP_NUMBER=60123456789
# PERSONAL_WHATSAPP_EXTRA_NUMBERS=60111111111,60122222222
# Seconds to wait after the last saved WhatsApp receipt before sending a batched "Document received" ack
WHATSAPP_DOCUMENT_RECEIVED_DEBOUNCE_SECONDS=3
# Base URL for WhatsApp file/edit links (must be reachable from your phone). Example: http://192.168.1.10
# Keep this on the LAN IP (no port) even when APP_URL is http://tido.local — many phones cannot resolve .local.
# When empty and APP_URL is localhost, tido tries your LAN IP automatically.
WHATSAPP_PUBLIC_APP_URL=

# Local/testing only: fixed OTP for listed phones (no Evolution send). Seeded Sample Spouse uses 60111222333.
WHATSAPP_LOGIN_DEV_OTP=123456
WHATSAPP_LOGIN_DEV_PHONES=60111222333
# Optional: path to Evolution clone for `npm run evolution` (default ../evolution-api)
# EVOLUTION_PATH=../evolution-api
