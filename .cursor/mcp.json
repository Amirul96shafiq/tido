{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "repowise": {
            "command": "repowise",
            "args": [
                "mcp",
                "G:/projects/tido"
            ]
        }
    }
}
